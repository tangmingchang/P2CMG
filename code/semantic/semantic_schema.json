{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evidence-linked painting-to-music proposal (unvalidated research design)",
  "type": "object",
  "required": ["case_id", "provenance", "visual_evidence", "interpretations", "music_proposals", "unknowns"],
  "additionalProperties": false,
  "properties": {
    "case_id": {"type": "string"},
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["author_type", "image_access", "human_review_status"],
      "properties": {
        "author_type": {"enum": ["AI_draft", "human", "adjudicated_human"]},
        "image_access": {"enum": ["full_image", "contact_sheet_only"]},
        "human_review_status": {"enum": ["pending", "reviewed", "disputed"]},
        "model_revision": {"type": ["string", "null"]}
      }
    },
    "visual_evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "observation", "certainty"], "properties": {
        "id": {"type": "string", "pattern": "^V[0-9]+$"},
        "observation": {"type": "string", "minLength": 1},
        "certainty": {"enum": ["clear", "ambiguous"]},
        "region_xyxy_normalized": {"type": ["array", "null"], "minItems": 4, "maxItems": 4,
          "items": {"type": "number", "minimum": 0, "maximum": 1}}
      }}},
    "interpretations": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["id", "evidence_ids", "interpretation", "alternative"], "properties": {
        "id": {"type": "string", "pattern": "^I[0-9]+$"},
        "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "interpretation": {"type": "string"}, "alternative": {"type": "string"}
      }}},
    "music_proposals": {"type": "array", "items": {"type": "object", "additionalProperties": false,
      "required": ["attribute", "value", "evidence_ids", "interpretation_ids", "rationale", "status"],
      "properties": {
        "attribute": {"enum": ["mood", "tempo", "instrumentation", "texture", "spatiality", "dynamics", "mode"]},
        "value": {"type": ["string", "null"]},
        "evidence_ids": {"type": "array", "items": {"type": "string"}},
        "interpretation_ids": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string"},
        "status": {"enum": ["interpretive_choice", "user_specified", "unknown"]},
        "verification": {"enum": ["pending", "human_supported", "disputed"]}
      }}},
    "unknowns": {"type": "array", "items": {"type": "string"}}
  },
  "$comment": "References must resolve to this case's evidence and interpretation IDs. Region boxes must be ordered. Self-reported certainty is not calibrated probability. A painting does not uniquely specify BPM, mode or instrumentation."
}
